{
  "name": "sudo-make-art",
  "productName": "Sudo Make Art",
  "version": "0.1.1",
  "description": "Offline, local-only design tool inspired by Canva",
  "main": "electron/main.js",
  "homepage": "https://github.com/theStyleWithin/sudo-make-art",
  "author": "Gamehopper",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "web:build": "node scripts/web-build.js",
    "android:sync": "node scripts/web-build.js && cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.thestylewithin.SudoMakeArt",
    "productName": "Sudo Make Art",
    "files": [
      "index.html",
      "src/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "executableName": "sudo-make-art"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "ffmpeg-static": "^5.3.0"
  },
  "license": "0BSD"
}
