{
  "name": "sudo-make-art",
  "productName": "Sudo Make Art",
  "version": "0.9.6",
  "description": "Offline, local-only tool for designs, videos and photos",
  "main": "electron/main.js",
  "homepage": "https://github.com/theStyleWithin/sudo-make-art",
  "author": "Gamehopper",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:linux": "node scripts/fetch-libjxl.js && node scripts/build-spout.js && electron-builder --linux AppImage --publish never",
    "dist:win": "node scripts/fetch-libjxl.js && node scripts/build-spout.js && electron-builder --win nsis portable --publish never",
    "web:build": "node scripts/web-build.js",
    "android:sync": "node scripts/web-build.js && cap sync android",
    "fetch:libjxl": "node scripts/fetch-libjxl.js",
    "build:spout": "node scripts/build-spout.js"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "electron": "^42.11.16",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.thestylewithin.SudoMakeArt",
    "productName": "Sudo Make Art",
    "files": [
      "index.html",
      "src/**",
      "electron/**",
      "build/icon.png",
      "package.json",
      "data/**",
      "!node_modules/tesseract.js-core/tesseract-core.*",
      "!node_modules/tesseract.js-core/tesseract-core-simd.*",
      "!node_modules/@tesseract.js-data/eng/4.0.0/**",
      "!node_modules/@mediapipe/tasks-vision/**/*.map",
      "!node_modules/@mediapipe/tasks-vision/**/*nosimd*",
      "!node_modules/@mediapipe/tasks-vision/vision_bundle.cjs",
      "!node_modules/@mediapipe/tasks-vision/vision.d.ts"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "executableName": "sudo-make-art"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/eng/**",
      "node_modules/wasm-feature-detect/**",
      "electron/ocr-*.js"
    ],
    "extraResources": [
      {
        "from": "vendor/libjxl/${os}",
        "to": "bin"
      },
      {
        "from": "vendor/spout/${os}",
        "to": "bin"
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@mediapipe/tasks-vision": "^0.10.14",
    "@tesseract.js-data/eng": "^1.0.0",
    "ffmpeg-static": "^5.3.0",
    "tesseract.js": "^5.1.1"
  },
  "license": "0BSD"
}
