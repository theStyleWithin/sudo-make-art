{
  "name": "sudo-make-art",
  "productName": "Sudo Make Art",
  "version": "0.4.0",
  "description": "Offline, local-only tool for designs, videos and photos",
  "main": "electron/main.js",
  "homepage": "https://github.com/theStyleWithin/sudo-make-art",
  "author": "Gamehopper",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:linux": "node scripts/fetch-libjxl.js && electron-builder --linux AppImage --publish never",
    "dist:win": "node scripts/fetch-libjxl.js && electron-builder --win nsis portable --publish never",
    "web:build": "node scripts/web-build.js",
    "android:sync": "node scripts/web-build.js && cap sync android",
    "fetch:libjxl": "node scripts/fetch-libjxl.js"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "electron": "^42.11.16",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.thestylewithin.SudoMakeArt",
    "productName": "Sudo Make Art",
    "files": [
      "index.html",
      "src/**",
      "electron/**",
      "build/icon.png",
      "package.json",
      "data/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "executableName": "sudo-make-art"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "vendor/libjxl/${os}",
        "to": "bin"
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "ffmpeg-static": "^5.3.0"
  },
  "license": "0BSD"
}
